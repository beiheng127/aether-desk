# ========== 聊天模型 ==========
# 未配置可用 Key（或仍是 sk-your-key 占位）时：自动走离线 Fixture（真实工具落库）。
# 配置有效 DEEPSEEK/OPENAI/AI_GATEWAY Key 后：只走真模型，不再调用 mock。
DEEPSEEK_API_KEY=sk-your-key
# 或
# OPENAI_API_KEY=sk-your-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# DeepSeek 默认：
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ========== Embedding / 向量（推荐单独配置）==========
# 仅有 DeepSeek 聊天 Key 时通常无法调 embeddings，会自动用 local-hash 兜底。
# 想要更强语义检索时配置下方任一：

# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536

# 国内兼容示例（按你的网关改）：
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# 强制本地 hashing 兜底：
# EMBEDDING_PROVIDER=local-hash

# ========== Hybrid 检索可调（可选）==========
# AETHER_RAG_TOP_K=5
# AETHER_RAG_RRF_K=60
# AETHER_RAG_KW_WEIGHT=1
# AETHER_RAG_VEC_WEIGHT=1
